<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LemieszeDesktop" x:Class="LemieszeDesktop.MainWindow" Title="Kalkulator lemieszy" Width="1120" Height="720" MinWidth="960" MinHeight="590" Background="Transparent" Foreground="White" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">
<Border CornerRadius="22" BorderBrush="#3A4865" BorderThickness="1" Margin="7" ClipToBounds="True">
<Border.Background><RadialGradientBrush Center="0.72,0.24" GradientOrigin="0.72,0.24" RadiusX="0.95" RadiusY="0.95"><GradientStop Color="#243A75" Offset="0"/><GradientStop Color="#141D32" Offset="0.48"/><GradientStop Color="#0C1220" Offset="1"/></RadialGradientBrush></Border.Background>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Margin="10,16,0,16" CornerRadius="15" Background="#A0222B42" BorderBrush="#3B4862" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="54"/><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Width="38" Height="38" Background="#293650" CornerRadius="10" VerticalAlignment="Top" Margin="0,13,0,0"><Viewbox Margin="10"><Canvas Width="24" Height="24"><Path Stroke="#E8EEFF" StrokeThickness="2" StrokeLineJoin="Round" Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z"/></Canvas></Viewbox></Border>
<Button x:Name="CalculatorNav" Grid.Row="1" Width="42" Height="42" Padding="0" Background="#3B5DE6" ToolTip="Kalkulator" Click="CalculatorNav_Click"><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconCalculator}"/></Canvas></Viewbox></Button>
<Button x:Name="EditorNav" Grid.Row="2" Width="42" Height="42" Padding="0" Background="#222B41" ToolTip="Katalog" Click="EditorNav_Click"><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconCatalog}"/></Canvas></Viewbox></Button>
</Grid></Border>
<Grid Grid.Column="1" Margin="20,16,20,20"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Kalkulator lemieszy" FontSize="25" FontWeight="Bold"/><TextBlock Text="Zestawienie części dla wybranych modeli" Foreground="#BBC8E3" FontSize="14" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Width="46" Height="42" Padding="0" Background="#263047" Click="Minimize_Click" ToolTip="Minimalizuj" Margin="0,0,6,0"><Path Stroke="White" StrokeThickness="2" Data="M0,0 H15" Stretch="None"/></Button><Button Width="46" Height="42" Padding="0" Background="#263047" Click="Close_Click" ToolTip="Zamknij"><Path Stroke="White" StrokeThickness="2" Data="M0,0 L13,13 M13,0 L0,13" Stretch="None"/></Button></StackPanel></Grid>
<Grid x:Name="CalculatorPage" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.88*"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Modele" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Wybierz modele i ustaw ilość" Foreground="#AAB7D2" FontSize="14" Margin="0,6,0,0"/></StackPanel>
<local:SmoothScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,17,0,14"><StackPanel>
<TextBlock Text="Małe lemiesze" FontSize="15" FontWeight="SemiBold" Foreground="#AFC4FA" Margin="3,0,0,8"/>
<ItemsControl ItemsSource="{Binding SmallModels}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#283651" CornerRadius="10" Margin="0,0,0,7" Padding="12,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="16" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource StepButton}" Tag="{Binding}" Click="DecreaseModel_Click"><Path Stroke="White" StrokeThickness="2" Data="{StaticResource IconMinus}" Width="15" Height="15" Stretch="Uniform"/></Button><TextBlock Text="{Binding Quantity}" Width="34" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/><Button Style="{StaticResource StepButton}" Tag="{Binding}" Click="IncreaseModel_Click"><Path Stroke="White" StrokeThickness="2" Data="{StaticResource IconPlus}" Width="15" Height="15" Stretch="Uniform"/></Button></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Duże lemiesze" FontSize="15" FontWeight="SemiBold" Foreground="#AFC4FA" Margin="3,12,0,8"/>
<ItemsControl ItemsSource="{Binding LargeModels}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#283651" CornerRadius="10" Margin="0,0,0,7" Padding="12,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="16" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource StepButton}" Tag="{Binding}" Click="DecreaseModel_Click"><Path Stroke="White" StrokeThickness="2" Data="{StaticResource IconMinus}" Width="15" Height="15" Stretch="Uniform"/></Button><TextBlock Text="{Binding Quantity}" Width="34" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/><Button Style="{StaticResource StepButton}" Tag="{Binding}" Click="IncreaseModel_Click"><Path Stroke="White" StrokeThickness="2" Data="{StaticResource IconPlus}" Width="15" Height="15" Stretch="Uniform"/></Button></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></local:SmoothScrollViewer>
<Grid Grid.Row="2"><Button Content="Wyczyść" Height="42" HorizontalAlignment="Right" Padding="22,8" Click="Clear_Click"/></Grid>
</Grid></Border>
<Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="10,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Zestawienie części" FontSize="21" FontWeight="SemiBold"/><Grid Grid.Row="1" Margin="0,16,0,12"><local:SmoothScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0"><ItemsControl ItemsSource="{Binding ResultGroups}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#1D2A43" CornerRadius="12" Margin="0,0,0,12" Padding="10,10"><StackPanel><StackPanel Orientation="Horizontal" Margin="5,0,0,9"><Path Data="{StaticResource IconThickness}" Stroke="#BFD0FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Text="{Binding ThicknessLabel}" FontSize="15" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#293751" CornerRadius="8" Margin="0,0,0,5" Padding="10,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Quantity}" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></local:SmoothScrollViewer></Grid><StackPanel Grid.Row="2"><TextBlock x:Name="TotalLabel" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Kopiuj" Style="{StaticResource PrimaryButton}" Click="Copy_Click" Margin="0,0,8,0"/><Button Content="Eksport TXT" Click="Export_Click"/></StackPanel></StackPanel></Grid></Border>
</Grid>
<Grid x:Name="EditorPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,14"><TextBlock Text="Katalog" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Edytuj modele i części — zmiany zapisują się automatycznie" FontSize="13" Foreground="#B2BED5" Margin="0,5,0,0"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,7,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Modele" FontSize="19" FontWeight="SemiBold"/><local:SmoothScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,10"><ItemsControl ItemsSource="{Binding Models}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#283650" CornerRadius="10" Padding="9" Margin="0,0,0,7"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Tag="{Binding}" Click="SelectModel_Click" Background="#35466B" HorizontalContentAlignment="Left" Padding="9,6"><TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/></Button><Button Grid.Column="1" Style="{StaticResource DangerButton}" Tag="{Binding}" Click="DeleteModel_Click" Margin="5,0,0,0"><Path Data="{StaticResource IconTrash}" Stroke="#FFD3DF" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button></Grid><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0"/><Button Tag="{Binding}" Click="ToggleCategory_Click" Background="#22304C" Padding="9,7" HorizontalContentAlignment="Left" Margin="0,6,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Category}" FontSize="13" Foreground="#B9CCF9"/><Path Data="{StaticResource IconChevron}" Stroke="#B9CCF9" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" Margin="8,0,0,0"/></StackPanel></Button></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></local:SmoothScrollViewer><Button Grid.Row="2" Content="+  Dodaj model" Style="{StaticResource PrimaryButton}" Height="40" Click="AddModel_Click"/></Grid></Border>
<Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="5,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Części" FontSize="19" FontWeight="SemiBold"/><local:SmoothScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,10"><ItemsControl ItemsSource="{Binding Parts}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#283650" CornerRadius="9" Padding="4,5" Margin="0,0,0,4"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="3,4" FontSize="15"/><Button Grid.Column="1" Style="{StaticResource DangerButton}" Tag="{Binding}" Click="DeletePart_Click" Margin="2,0,0,0" Width="28" Height="28" Padding="5"><Path Data="{StaticResource IconTrash}" Stroke="#FFD3DF" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="3,4,0,0"><TextBlock Text="Grubość (mm)" Foreground="#B2C2E2" VerticalAlignment="Center" FontSize="13"/><TextBox Width="54" Margin="8,0,0,0" HorizontalContentAlignment="Center" Text="{Binding Thickness, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Padding="5,3"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></local:SmoothScrollViewer><Button Grid.Row="2" Content="+  Dodaj część" Style="{StaticResource PrimaryButton}" Height="40" Click="AddPart_Click"/></Grid></Border>
<Border Grid.Column="2" Style="{StaticResource PanelStyle}" Margin="7,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Części modelu" FontSize="19" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="{Binding SelectedModelTitle}" FontSize="13" Foreground="#AFC4FA" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/><local:SmoothScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,10"><ItemsControl x:Name="RecipesView" ItemsSource="{Binding SortedVisibleRecipes}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#283650" CornerRadius="10" Padding="8" Margin="0,0,0,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Button Tag="{Binding}" Click="OpenPartPicker_Click" Background="#35466B" Padding="9,8" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PartName}" FontSize="14" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,3,0" Grid.Column="1"><Path Data="{StaticResource IconThickness}" Stroke="#BFD0FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Text="{Binding ThicknessLabel}" FontSize="13" Margin="4,0,0,0" VerticalAlignment="Center"/></StackPanel><Path Grid.Column="2" Data="{StaticResource IconChevron}" Stroke="White" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" Margin="6,0,0,0"/></Grid></Button><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0"><Button Style="{StaticResource StepButton}" Tag="{Binding}" Click="DecreaseRecipe_Click"><Path Data="{StaticResource IconMinus}" Stroke="White" StrokeThickness="2" Width="15" Height="15" Stretch="Uniform"/></Button><TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontSize="16"/><Button Style="{StaticResource StepButton}" Tag="{Binding}" Click="IncreaseRecipe_Click"><Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2" Width="15" Height="15" Stretch="Uniform"/></Button><Button Style="{StaticResource DangerButton}" Tag="{Binding}" Click="DeleteRecipe_Click" Margin="8,0,0,0"><Path Data="{StaticResource IconTrash}" Stroke="#FFD3DF" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></local:SmoothScrollViewer><Button Grid.Row="3" Content="+  Dodaj do modelu" Style="{StaticResource PrimaryButton}" Height="40" Click="AddRecipe_Click"/></Grid></Border>
</Grid></Grid>
<Popup x:Name="PartPicker" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="#1D2A43" BorderBrush="#637BA8" BorderThickness="1" CornerRadius="12" Padding="6" Width="320" MaxHeight="310"><local:SmoothScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="294"><ItemsControl ItemsSource="{Binding SortedParts}"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="ChoosePart_Click" HorizontalContentAlignment="Stretch" Background="#293955" Margin="0,0,0,4" Padding="12,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Grid.Column="1" Margin="8,0,0,0"><Path Data="{StaticResource IconThickness}" Stroke="#BFD0FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Text="{Binding ThicknessLabel}" FontSize="13" Margin="4,0,0,0"/></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></local:SmoothScrollViewer></Border></Popup>
</Grid></Grid></Border></Window>